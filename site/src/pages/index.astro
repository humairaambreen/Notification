---
const siteUrl =
    import.meta.env.PUBLIC_SITE_URL || "https://notification-macos.pages.dev";
const googleVerify =
    import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ||
    "rv2MZYgWoTBQlV-NCJVhoy731DXpBVHxO5TORElaMSg";
const bingVerify =
    import.meta.env.PUBLIC_BING_SITE_VERIFICATION ||
    "EED153ECA357102FA8182FA161010BB1";
const yandexVerify =
    import.meta.env.PUBLIC_YANDEX_VERIFICATION || "03a2721869e58e72";
const indexNowKey = import.meta.env.PUBLIC_INDEXNOW_KEY || "";

const dmgUrl =
    "https://github.com/humairaambreen/Notification/releases/latest/download/Notification.dmg";
const repoUrl = "https://github.com/humairaambreen/Notification";

const title =
    "Notification for macOS — Key Light, Top Bar Camera Light & Trackpad Haptics";
const description =
    "Minimal macOS hardware notification app. Blinks your MacBook key light, pulses the top bar camera indicator, and vibrates your Force Touch trackpad—even in Do Not Disturb.";

const faqs = [
    {
        q: "How do I get a notification light on macOS?",
        a: "Notification turns your MacBook's existing hardware—the Caps Lock key LED, the green indicator light next to the FaceTime camera, and the Force Touch trackpad actuator—into a silent physical notification system for any macOS app like WhatsApp, Slack, Messages, or Discord.",
    },
    {
        q: "Does blinking the Caps Lock key light affect normal typing?",
        a: "No. Notification drives the LED element directly via IOKit HID without changing the macOS Caps Lock modifier state, so your typing stays completely lowercase and normal while the key light blinks.",
    },
    {
        q: "Does the top bar camera indicator blink open or record from the camera?",
        a: "No video or photo is ever captured, and no preview window opens. Notification pulses the hardware indicator circuit in the background using a frame-discarding node.",
    },
    {
        q: "Does it work during macOS Do Not Disturb (Focus) mode or when banners are hidden?",
        a: "Yes. Notification listens to macOS usernoted delivery events directly, so your key LED, camera indicator light, and trackpad vibrations fire even when Do Not Disturb is active or when an app's banner style is set to None.",
    },
    {
        q: "How does it stop blinking and vibrating?",
        a: "Press the physical Caps Lock key once, switch to the app that sent the notification, or let it automatically stop after your configured duration (from 10 seconds up to 5 minutes).",
    },
    {
        q: "How does the MacBook trackpad vibrate when my hand isn't resting on it?",
        a: "Notification actuates your MacBook's Force Touch haptic engine directly via MultitouchSupport, producing crisp physical taps you can feel on the palm rest or hear softly on your desk without touching the glass.",
    },
];

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": `${siteUrl}/#website`,
            url: siteUrl,
            name: "Notification for macOS",
            description: description,
            publisher: {
                "@type": "Person",
                name: "humairaambreen",
                url: "https://github.com/humairaambreen",
            },
        },
        {
            "@type": "SoftwareApplication",
            "@id": `${siteUrl}/#app`,
            name: "Notification",
            url: siteUrl,
            operatingSystem: "macOS 13.0+",
            applicationCategory: "UtilitiesApplication",
            offers: {
                "@type": "Offer",
                price: "0",
                priceCurrency: "USD",
            },
            downloadUrl: dmgUrl,
            softwareVersion: "4.0",
            author: {
                "@type": "Person",
                name: "humairaambreen",
                url: "https://github.com/humairaambreen",
            },
            description: description,
            featureList: [
                "Direct MacBook Caps Lock key LED notification blinking without affecting typing",
                "macOS top bar camera indicator light notification pulsing without video capture",
                "Force Touch trackpad haptic vibration alerts without resting your hand",
                "Works during macOS Do Not Disturb (Focus) and when banners are set to None",
                "Instant auto-stop when pressing Caps Lock or opening the notifying app",
            ],
        },
        {
            "@type": "HowTo",
            name: "How to get LED and trackpad vibration notifications on a MacBook",
            step: [
                {
                    "@type": "HowToStep",
                    position: 1,
                    name: "Download Notification.dmg",
                    text: "Download Notification.dmg and drag Notification.app into your Applications folder.",
                },
                {
                    "@type": "HowToStep",
                    position: 2,
                    name: "Enable Accessibility",
                    text: "Allow Notification under System Settings > Privacy & Security > Accessibility.",
                },
                {
                    "@type": "HowToStep",
                    position: 3,
                    name: "Choose apps and hardware alerts",
                    text: "Click the menu bar bell icon, add your apps, and toggle Blink, Camera, and Buzz.",
                },
            ],
        },
        {
            "@type": "FAQPage",
            "@id": `${siteUrl}/#faq`,
            mainEntity: faqs.map((item) => ({
                "@type": "Question",
                name: item.q,
                acceptedAnswer: {
                    "@type": "Answer",
                    text: item.a,
                },
            })),
        },
    ],
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta
            name="keywords"
            content="macOS notification light, MacBook LED notification, MacBook key light blink, macOS camera light notification, Force Touch trackpad vibration notifications, silent notifications Mac, Do Not Disturb hardware alerts macOS"
        />
        <meta name="author" content="humairaambreen" />
        <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1"
        />
        <link rel="canonical" href={siteUrl} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        {googleVerify && (
            <meta name="google-site-verification" content={googleVerify} />
        )}
        {bingVerify && <meta name="msvalidate.01" content={bingVerify} />}
        {yandexVerify && (
            <meta name="yandex-verification" content={yandexVerify} />
        )}
        {indexNowKey && <meta name="indexnow-key" content={indexNowKey} />}

        <meta property="og:type" content="website" />
        <meta property="og:url" content={siteUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content="Notification for macOS" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />

        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        <style>
            :root {
                --bg: #050507;
                --card: #101014;
                --inner: #16161c;
                --inner-2: #1c1c24;
                --border: #22222a;
                --inner-border: #2a2a34;
                --text: #f4f4f6;
                --muted: #8e8e98;
                --green: #30d158;
                --green-glow: rgba(48, 209, 88, 0.75);
                --led-off: #1b2e20;
                --pop-bg: #18181d;
                --pop-border: #2b2b34;
                --pop-line: rgba(255, 255, 255, 0.22);
                --pop-sub: #a1a1aa;
                --pop-muted: #8e8e93;
                --pop-shadow: 0 20px 40px rgba(0, 0, 0, 0.65);
            }

            html[data-theme="light"] {
                --bg: #f3f3f6;
                --card: #ffffff;
                --inner: #f5f5f8;
                --inner-2: #ebebef;
                --border: #e2e2e8;
                --inner-border: #d4d4dc;
                --text: #111114;
                --muted: #686872;
                --green: #28cd41;
                --green-glow: rgba(40, 205, 65, 0.65);
                --led-off: #d2e4d6;
                --pop-bg: #7d7d83;
                --pop-border: rgba(255, 255, 255, 0.42);
                --pop-line: rgba(255, 255, 255, 0.34);
                --pop-sub: rgba(255, 255, 255, 0.82);
                --pop-muted: rgba(255, 255, 255, 0.78);
                --pop-shadow:
                    0 18px 38px rgba(0, 0, 0, 0.18),
                    0 0 0 1px rgba(0, 0, 0, 0.08);
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html,
            body {
                width: 100%;
                min-height: 100dvh;
                background: var(--bg);
                color: var(--text);
                font-family:
                    -apple-system, BlinkMacSystemFont, "SF Pro Display",
                    "SF Pro Text", "Inter", sans-serif;
                -webkit-font-smoothing: antialiased;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            /* First Screen: Full-Viewport Interlocking Bento Grid */
            .viewport {
                width: 100%;
                height: 100dvh;
                padding: clamp(12px, 1.8vw, 22px);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .bento {
                width: 100%;
                max-width: 1380px;
                height: 100%;
                max-height: 860px;
                display: grid;
                grid-template-columns: repeat(12, 1fr);
                grid-template-rows: repeat(6, 1fr);
                gap: clamp(10px, 1vw, 14px);
            }

            .cell {
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 24px;
                padding: clamp(16px, 1.6vw, 24px);
                position: relative;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

            /* Staggered Interlocking Bento Spans (No full-height columns) */
            .cell-hero {
                grid-column: 1 / 6;
                grid-row: 1 / 4;
            }

            .cell-topbar {
                grid-column: 6 / 10;
                grid-row: 1 / 3;
            }

            .cell-dnd {
                grid-column: 10 / 13;
                grid-row: 1 / 3;
            }

            .cell-key {
                grid-column: 1 / 4;
                grid-row: 4 / 7;
            }

            .cell-autostop {
                grid-column: 4 / 6;
                grid-row: 4 / 7;
            }

            .cell-app {
                grid-column: 6 / 10;
                grid-row: 3 / 7;
            }

            .cell-trackpad {
                grid-column: 10 / 13;
                grid-row: 3 / 7;
            }

            /* Card Typography */
            .cell-title {
                font-size: clamp(14.5px, 1.15vw, 17px);
                font-weight: 600;
                letter-spacing: -0.02em;
                color: var(--text);
            }

            .cell-sub {
                font-size: 12.5px;
                color: var(--muted);
                margin-top: 3px;
                line-height: 1.4;
            }

            .cell-footer {
                z-index: 2;
            }

            /* Cell 1: Hero */
            .hero-top {
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .brand-pill {
                display: inline-flex;
                align-items: center;
                gap: 9px;
                font-size: 15px;
                font-weight: 600;
                letter-spacing: -0.015em;
            }

            .brand-bell {
                width: 16px;
                height: 16px;
                fill: var(--text);
                display: block;
            }

            .theme-toggle {
                width: 58px;
                height: 30px;
                padding: 3px;
                border-radius: 999px;
                border: 1px solid var(--border);
                background: var(--inner);
                position: relative;
                display: inline-flex;
                align-items: center;
                justify-content: space-between;
                cursor: pointer;
            }

            .theme-icon {
                width: 22px;
                height: 22px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                z-index: 2;
                color: var(--muted);
                transition: color 0.2s ease;
            }

            .theme-icon svg {
                width: 13px;
                height: 13px;
                fill: currentColor;
            }

            .theme-thumb {
                position: absolute;
                top: 3px;
                left: 3px;
                width: 22px;
                height: 22px;
                border-radius: 50%;
                background: var(--text);
                transition: transform 0.22s cubic-bezier(0.2, 0.85, 0.3, 1);
                z-index: 1;
            }

            html:not([data-theme="light"]) .theme-icon-moon {
                color: var(--bg);
            }

            html[data-theme="light"] .theme-thumb {
                transform: translateX(28px);
            }

            html[data-theme="light"] .theme-icon-sun {
                color: var(--bg);
            }

            .hero-copy {
                margin: auto 0;
                padding: 8px 0;
            }

            .hero-copy h1 {
                font-size: clamp(24px, 2.5vw, 36px);
                font-weight: 700;
                letter-spacing: -0.04em;
                line-height: 1.08;
                margin-bottom: 10px;
            }

            .hero-copy p {
                font-size: clamp(13px, 1vw, 14.5px);
                color: var(--muted);
                line-height: 1.5;
                max-width: 44ch;
            }

            .hero-actions {
                display: flex;
                align-items: center;
                gap: 10px;
                flex-wrap: wrap;
            }

            .btn-primary {
                height: 38px;
                padding: 0 18px;
                border-radius: 999px;
                background: var(--text);
                color: var(--bg);
                font-size: 12.5px;
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

            .btn-ghost {
                height: 38px;
                padding: 0 16px;
                border-radius: 999px;
                border: 1px solid var(--border);
                background: var(--inner);
                color: var(--text);
                font-size: 12.5px;
                font-weight: 500;
                display: inline-flex;
                align-items: center;
                gap: 7px;
            }

            .btn-ghost svg {
                width: 14px;
                height: 14px;
                fill: currentColor;
            }

            /* Visual Stage inside Bento Cards */
            .visual-stage {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                width: 100%;
                min-height: 0;
                user-select: none;
            }

            /* Cell 2: MacBook Top Bezel & Camera LED Blinking Visual */
            .mac-top-frame {
                width: 100%;
                max-width: 320px;
                height: 54px;
                background: var(--inner);
                border: 1px solid var(--inner-border);
                border-radius: 14px;
                position: relative;
                overflow: hidden;
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

            .mac-notch-housing {
                width: 124px;
                height: 28px;
                background: #09090b;
                border-bottom-left-radius: 10px;
                border-bottom-right-radius: 10px;
                border: 1px solid var(--inner-border);
                border-top: none;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
            }

            .cam-optic {
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: #161822;
                border: 1px solid #2c2c38;
            }

            .cam-blink-light {
                width: 6.5px;
                height: 6.5px;
                border-radius: 50%;
                background: #1b2e20;
                transition: all 0.08s ease;
            }

            .cam-blink-light.lit {
                background: var(--green);
                box-shadow:
                    0 0 8px 2px var(--green-glow),
                    0 0 18px 5px rgba(48, 209, 88, 0.4);
            }

            .mb-sys-icon {
                width: 13px;
                height: 13px;
                fill: var(--text);
                display: block;
            }

            .mb-loc-icon {
                width: 9px;
                height: 9px;
                fill: var(--text);
                display: block;
                margin-left: -4px;
            }

            .mb-clock {
                font-variant-numeric: tabular-nums;
                white-space: nowrap;
                color: var(--text);
                font-size: 11px;
                font-weight: 500;
            }

            /* Cell 3: Author GitHub Card */
            .author-card {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                border-radius: 16px;
                background: var(--inner);
                border: 1px solid var(--inner-border);
            }

            .author-avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: var(--inner-2);
                border: 1px solid var(--inner-border);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .author-avatar svg {
                width: 19px;
                height: 19px;
                fill: var(--text);
            }

            .author-meta {
                display: flex;
                flex-direction: column;
                gap: 1px;
            }

            .author-handle {
                font-size: 13.5px;
                font-weight: 600;
                color: var(--text);
            }

            .author-role {
                font-size: 11px;
                color: var(--muted);
            }

            /* Cell 4: Key Blinking Visual */
            .keyboard-closeup {
                display: flex;
                gap: 8px;
                padding: 10px;
                background: var(--inner);
                border: 1px solid var(--inner-border);
                border-radius: 14px;
                width: 100%;
                max-width: 260px;
            }

            .hw-key {
                height: 58px;
                border-radius: 9px;
                background: var(--card);
                border: 1px solid var(--inner-border);
                border-bottom-width: 3px;
                padding: 8px 11px;
                display: flex;
                flex-direction: column;
                justify-content: flex-end;
                position: relative;
                color: var(--muted);
                font-size: 11.5px;
                font-weight: 500;
            }

            .hw-key.key-main {
                flex: 1.8;
                color: var(--text);
            }

            .hw-key.key-letter {
                flex: 1;
                align-items: center;
                justify-content: center;
                font-size: 14px;
                color: var(--muted);
            }

            .key-led-pinhole {
                position: absolute;
                top: 9px;
                left: 11px;
                width: 6.5px;
                height: 6.5px;
                border-radius: 50%;
                background: var(--led-off);
                transition: all 0.06s ease;
            }

            .key-led-pinhole.lit {
                background: var(--green);
                box-shadow:
                    0 0 8px 2px var(--green-glow),
                    0 0 18px 5px rgba(48, 209, 88, 0.4);
            }

            /* Cell 5: Auto-Stop Visual */
            .autostop-stack {
                display: flex;
                flex-direction: column;
                gap: 8px;
                width: 100%;
            }

            .stop-chip {
                padding: 9px 12px;
                border-radius: 11px;
                background: var(--inner);
                border: 1px solid var(--inner-border);
                font-size: 11.5px;
                font-weight: 500;
                color: var(--text);
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .stop-kbd {
                padding: 2px 6px;
                border-radius: 5px;
                background: var(--inner-2);
                border: 1px solid var(--inner-border);
                font-size: 10px;
                color: var(--muted);
            }

            /* Cell 6: App Popover Screenshot Visual */
            .popover-showcase {
                width: 100%;
                max-width: 304px;
                display: flex;
                flex-direction: column;
                align-items: center;
            }

            .menubar-strip {
                width: 100%;
                height: 28px;
                padding: 0 10px;
                margin-bottom: 6px;
                border-radius: 9px;
                background: var(--inner);
                border: 1px solid var(--inner-border);
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .menubar-strip-right {
                display: flex;
                align-items: center;
                gap: 9px;
            }

            .menubar-pill-top {
                width: 34px;
                height: 20px;
                border-radius: 999px;
                background: var(--inner-2);
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid var(--inner-border);
            }

            .menubar-pill-top svg {
                width: 11px;
                height: 11px;
                fill: var(--text);
            }

            .popover-card {
                width: 100%;
                background: var(--pop-bg);
                backdrop-filter: blur(24px) saturate(140%);
                color: #ffffff;
                border: 1px solid var(--pop-border);
                border-radius: 18px;
                padding: 13px 15px;
                box-shadow: var(--pop-shadow);
                position: relative;
                transition:
                    background 0.2s ease,
                    border-color 0.2s ease,
                    box-shadow 0.2s ease;
            }

            .popover-card::before {
                content: "";
                position: absolute;
                top: -5px;
                left: 22px;
                transform: rotate(45deg);
                width: 9px;
                height: 9px;
                background: var(--pop-bg);
                border-left: 1px solid var(--pop-border);
                border-top: 1px solid var(--pop-border);
                transition:
                    background 0.2s ease,
                    border-color 0.2s ease;
            }

            .pop-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 10px;
            }

            .pop-brand {
                display: flex;
                align-items: center;
                gap: 6px;
                font-size: 13.5px;
                font-weight: 700;
            }

            .pop-brand svg {
                width: 13px;
                height: 13px;
                fill: #ffffff;
            }

            .pop-icons {
                display: flex;
                gap: 5px;
            }

            .pop-circle {
                width: 23px;
                height: 23px;
                border-radius: 50%;
                border: 1px solid var(--pop-line);
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

            .pop-circle svg {
                width: 10.5px;
                height: 10.5px;
                fill: #ffffff;
            }

            .pop-search {
                height: 29px;
                border-radius: 8px;
                border: 1px solid var(--pop-line);
                display: flex;
                align-items: center;
                gap: 7px;
                padding: 0 9px;
                font-size: 11.5px;
                color: var(--pop-muted);
                margin-bottom: 10px;
            }

            .pop-search svg {
                width: 11px;
                height: 11px;
                fill: var(--pop-muted);
            }

            .pop-sec {
                font-size: 10.5px;
                font-weight: 700;
                margin-bottom: 5px;
                color: #ffffff;
            }

            .pop-row {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 3px 0;
            }

            .pop-app-ico {
                width: 24px;
                height: 24px;
                border-radius: 6px;
                background: #141417;
                border: 1px solid rgba(255, 255, 255, 0.14);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .pop-app-ico.wa svg {
                width: 15px;
                height: 15px;
                fill: #30d158;
            }

            .pop-row-text {
                flex: 1;
                min-width: 0;
            }

            .pop-row-name {
                font-size: 12px;
                font-weight: 500;
                color: #ffffff;
                line-height: 1.2;
            }

            .pop-row-sub {
                font-size: 10px;
                color: var(--pop-sub);
            }

            .pop-chevron {
                font-size: 12px;
                font-weight: 600;
                color: rgba(255, 255, 255, 0.85);
                margin-right: 2px;
            }

            .pop-toggle {
                width: 30px;
                height: 18px;
                border-radius: 999px;
                background: #0a84ff;
                position: relative;
            }

            .pop-toggle::after {
                content: "";
                position: absolute;
                top: 2px;
                right: 2px;
                width: 14px;
                height: 14px;
                border-radius: 50%;
                background: #ffffff;
            }

            .pop-plus {
                width: 16px;
                height: 16px;
                border-radius: 50%;
                border: 1.5px solid #ffffff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 11px;
                line-height: 1;
            }

            /* Cell 7: Trackpad Vibrating Visual (no center dot) */
            .trackpad-surface {
                width: 100%;
                max-width: 220px;
                height: 136px;
                border-radius: 15px;
                background: var(--inner);
                border: 1px solid var(--inner-border);
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                animation: tp-vibrate 0.18s infinite;
            }

            .tp-ring {
                position: absolute;
                width: 26px;
                height: 26px;
                border-radius: 50%;
                border: 1px solid var(--muted);
                opacity: 0;
            }

            .trackpad-surface .r1 {
                animation: tp-pulse 1.2s infinite cubic-bezier(0.16, 1, 0.3, 1);
            }

            .trackpad-surface .r2 {
                animation: tp-pulse 1.2s 0.4s infinite
                    cubic-bezier(0.16, 1, 0.3, 1);
            }

            .trackpad-surface .r3 {
                animation: tp-pulse 1.2s 0.8s infinite
                    cubic-bezier(0.16, 1, 0.3, 1);
            }

            @keyframes tp-pulse {
                0% {
                    transform: scale(0.4);
                    opacity: 0.7;
                }
                100% {
                    transform: scale(6);
                    opacity: 0;
                }
            }

            @keyframes tp-vibrate {
                0%,
                100% {
                    transform: translate(0, 0);
                }
                25% {
                    transform: translate(-1px, 0.6px);
                }
                50% {
                    transform: translate(1px, -0.6px);
                }
                75% {
                    transform: translate(-0.6px, -0.6px);
                }
            }

            /* Below-the-Fold SEO & AEO FAQ Section */
            .seo-section {
                max-width: 1380px;
                margin: 0 auto;
                padding: 48px clamp(12px, 1.8vw, 22px) 72px;
            }

            .seo-header {
                margin-bottom: 24px;
            }

            .seo-header h2 {
                font-size: clamp(22px, 2.2vw, 30px);
                font-weight: 700;
                letter-spacing: -0.03em;
            }

            .faq-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 14px;
            }

            .faq-card {
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 20px;
                padding: 22px 24px;
            }

            .faq-card h3 {
                font-size: 15px;
                font-weight: 600;
                margin-bottom: 8px;
                color: var(--text);
            }

            .faq-card p {
                font-size: 13.5px;
                color: var(--muted);
                line-height: 1.55;
            }

            .seo-footer {
                margin-top: 32px;
                padding-top: 20px;
                border-top: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                font-size: 12.5px;
                color: var(--muted);
                flex-wrap: wrap;
                gap: 12px;
            }

            /* Responsive Scaling */
            @media (max-width: 1024px) {
                .viewport {
                    height: auto;
                    min-height: 100dvh;
                }

                .bento {
                    height: auto;
                    max-height: none;
                    grid-template-columns: repeat(2, 1fr);
                    grid-template-rows: auto;
                }

                .cell-hero {
                    grid-column: 1 / 3;
                    grid-row: auto;
                    min-height: 250px;
                }

                .cell-topbar,
                .cell-dnd,
                .cell-key,
                .cell-autostop,
                .cell-app,
                .cell-trackpad {
                    grid-column: auto;
                    grid-row: auto;
                    min-height: 220px;
                }

                .faq-grid {
                    grid-template-columns: 1fr;
                }
            }

            @media (max-width: 680px) {
                .bento {
                    grid-template-columns: 1fr;
                }

                .cell-hero,
                .cell-topbar,
                .cell-dnd,
                .cell-key,
                .cell-autostop,
                .cell-app,
                .cell-trackpad {
                    grid-column: 1 / -1;
                }
            }
        </style>
    </head>


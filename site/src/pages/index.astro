                            <span class="tp-ring r2"></span>
                            <span class="tp-ring r3"></span>
                        </div>
                    </div>

                    <div class="cell-footer">
                        <div class="cell-title">Trackpad Vibration</div>
                        <div class="cell-sub">
                            Vibrates your Force Touch trackpad directly without
                            resting your hand.
                        </div>
                    </div>
                </section>
            </div>
        </main>

        <!-- Below-the-Fold SEO & AEO FAQ Section -->
        <section
            class="seo-section"
            id="faq"
            aria-label="Frequently Asked Questions"
        >
            <div class="seo-header">
                <h2>Frequently Asked Questions</h2>
            </div>
            <div class="faq-grid">
                {faqs.map((item) => (
                    <article class="faq-card">
                        <h3>{item.q}</h3>
                        <p>{item.a}</p>
                    </article>
                ))}
            </div>
            <footer class="seo-footer">
                <span>
                    Notification for macOS · Built by{" "}
                    <a
                        href="https://github.com/humairaambreen"
                        target="_blank"
                        rel="noopener"
                    >
                        @humairaambreen
                    </a>
                </span>
                <div>
                    <a href={dmgUrl}>Download .DMG</a> ·{" "}
                    <a href={repoUrl} target="_blank" rel="noopener">
                        GitHub
                    </a>{" "}
                    · <a href="/llms.txt">llms.txt</a> ·{" "}
                    <a href="/sitemap.xml">Sitemap</a>
                </div>
            </footer>
        </section>

        <script is:inline>
            (function () {
                let phase = true;
                const keyLed = document.getElementById("v-key-led");
                const camLed = document.getElementById("v-cam-led");
                const clockEl = document.getElementById("v-menubar-clock");

                const days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
                const months = [
                    "Jan",
                    "Feb",
                    "Mar",
                    "Apr",
                    "May",
                    "Jun",
                    "Jul",
                    "Aug",
                    "Sep",
                    "Oct",
                    "Nov",
                    "Dec",
                ];

                function updateClock() {
                    if (!clockEl) return;
                    const now = new Date();
                    const dayName = days[now.getDay()];
                    const dateNum = now.getDate();
                    const monthName = months[now.getMonth()];
                    let hours = now.getHours();
                    const ampm = hours >= 12 ? "PM" : "AM";
                    hours = hours % 12 || 12;
                    const mins = String(now.getMinutes()).padStart(2, "0");
                    const secs = String(now.getSeconds()).padStart(2, "0");
                    clockEl.textContent =
                        dayName +
                        " " +
                        dateNum +
                        " " +
                        monthName +
                        "  " +
                        hours +
                        ":" +
                        mins +
                        ":" +
                        secs +
                        " " +
                        ampm;
                }

                updateClock();
                setInterval(updateClock, 1000);

                setInterval(function () {
                    phase = !phase;
                    keyLed.classList.toggle("lit", phase);
                    camLed.classList.toggle("lit", phase);
                }, 420);

                const themeBtn = document.getElementById("theme-switch");
                if (themeBtn) {
                    themeBtn.addEventListener("click", function () {
                        const isLight =
                            document.documentElement.getAttribute(
                                "data-theme",
                            ) === "light";
                        if (isLight) {
                            document.documentElement.removeAttribute(
                                "data-theme",
                            );
                        } else {
                            document.documentElement.setAttribute(
                                "data-theme",
                                "light",
                            );
                        }
                    });
                }
            })();
        </script>
    </body>
</html>

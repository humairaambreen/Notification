        <script is:inline>
            (function () {
                let running = true;
                let useBlink = true;
                let useCamera = true;
                let useBuzz = true;
                let ledOn = true;

                const capsLed = document.getElementById("caps-led");
                const camLed = document.getElementById("cam-led");
                const trackpad = document.getElementById("trackpad-box");
                const toggleBtn = document.getElementById("sim-toggle-btn");
                const popTestBtn = document.getElementById("pop-test-btn");
                const capsBtn = document.getElementById("sim-caps-btn");
                const keyCaps = document.getElementById("key-capslock");
                const statusEl = document.getElementById("sim-status");

                const modeBlinkBtn = document.getElementById("mode-blink");
                const modeCamBtn = document.getElementById("mode-camera");
                const modeBuzzBtn = document.getElementById("mode-buzz");

                function syncUI() {
                    modeBlinkBtn.classList.toggle("active", useBlink);
                    modeCamBtn.classList.toggle("active", useCamera);
                    modeBuzzBtn.classList.toggle("active", useBuzz);

                    toggleBtn.textContent = running
                        ? "Stop Live Alert"
                        : "Test Live Alert";
                    popTestBtn.textContent = running ? "Stop" : "Test";

                    const parts = [];
                    if (useBlink) parts.push("Blink");
                    if (useCamera) parts.push("Camera");
                    if (useBuzz) parts.push("Buzz");

                    statusEl.textContent = running
                        ? "Alerting: " + (parts.join(" + ") || "Off")
                        : "Stopped (Press Test to start)";

                    trackpad.classList.toggle("buzzing", running && useBuzz);
                    if (!running) {
                        capsLed.classList.remove("on");
                        camLed.classList.remove("on");
                    }
                }

                setInterval(function () {
                    if (!running) return;
                    ledOn = !ledOn;
                    capsLed.classList.toggle("on", useBlink && ledOn);
                    camLed.classList.toggle("on", useCamera && ledOn);
                }, 380);

                function toggleRun() {
                    running = !running;
                    syncUI();
                }

                function stopByCaps() {
                    running = false;
                    syncUI();
                    statusEl.textContent = "Stopped via Caps Lock key";
                }

                toggleBtn.addEventListener("click", toggleRun);
                popTestBtn.addEventListener("click", toggleRun);
                capsBtn.addEventListener("click", stopByCaps);
                keyCaps.addEventListener("click", stopByCaps);

                modeBlinkBtn.addEventListener("click", function () {
                    useBlink = !useBlink;
                    if (!useBlink && !useCamera && !useBuzz) useBuzz = true;
                    syncUI();
                });
                modeCamBtn.addEventListener("click", function () {
                    useCamera = !useCamera;
                    if (!useBlink && !useCamera && !useBuzz) useBlink = true;
                    syncUI();
                });
                modeBuzzBtn.addEventListener("click", function () {
                    useBuzz = !useBuzz;
                    if (!useBlink && !useCamera && !useBuzz) useBlink = true;
                    syncUI();
                });
            })();
        </script>
    </body>
</html>

# Site URL
PUBLIC_SITE_URL="https://notification-macos.pages.dev"

# Search Engine Verification Codes (Add your verification tokens here)
PUBLIC_GOOGLE_SITE_VERIFICATION="your-google-search-console-token"
PUBLIC_BING_SITE_VERIFICATION="your-bing-webmaster-token"
PUBLIC_YANDEX_VERIFICATION="your-yandex-webmaster-token"

# IndexNow Key for Instant Bing / Yandex Indexing
PUBLIC_INDEXNOW_KEY="your-indexnow-key"
